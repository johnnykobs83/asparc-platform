# =====================================================================
# ASPARC platform – environment variables
# Copy to .env.local for local development. In production set these in
# Vercel → Project → Settings → Environment Variables.
# NEVER commit real values. Every secret below is server-side only;
# only variables prefixed NEXT_PUBLIC_ are ever exposed to the browser.
# =====================================================================

# --- Site -------------------------------------------------------------
# Public base URL (used in emails, HubSpot notes and links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Data backend -----------------------------------------------------
# "supabase" (production) or "local" (development only – JSON file store,
# refused when NODE_ENV=production).
DATA_BACKEND=local
# Local JSON store path (DATA_BACKEND=local only)
LOCAL_DB_PATH=.data/local-db.json

# --- Supabase (Phase 1 – required for production) ---------------------
# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key bypasses RLS – server only, never expose
SUPABASE_SERVICE_ROLE_KEY=

# --- Admin authentication (Phase 1 – required) ------------------------
# Long random string used to sign admin session cookies.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Local development only: first-run owner account for DATA_BACKEND=local.
# Ignored in production (create admins with `npm run admin:create`).
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# --- OpenAI – AI receptionist (Phase 1 – optional but recommended) ----
# Without a key the receptionist runs in "guided mode" (rules-based,
# knowledge-base answers + lead capture) – still fully functional.
OPENAI_API_KEY=
# Any chat-completions model with function calling. A small/cheap model
# is sufficient for a receptionist.
OPENAI_MODEL=gpt-4o-mini

# --- HubSpot CRM (Phase 1 – optional; free CRM tier is sufficient) ----
# HubSpot → Settings → Integrations → Private Apps → create app with scopes:
#   crm.objects.contacts.read, crm.objects.contacts.write,
#   crm.objects.deals.read, crm.objects.deals.write,
#   crm.schemas.contacts.read, crm.schemas.contacts.write
HUBSPOT_ACCESS_TOKEN=
# Optional – your HubSpot account ID (for "open in HubSpot" links)
HUBSPOT_PORTAL_ID=
# Optional – create deals in a pipeline. Leave blank to sync contacts +
# notes only. Stage IDs come from HubSpot → Settings → Objects → Deals → Pipelines.
HUBSPOT_PIPELINE_ID=
HUBSPOT_STAGE_NEW_ENQUIRY=
HUBSPOT_STAGE_CONTACTED=
HUBSPOT_STAGE_QUALIFIED=
HUBSPOT_STAGE_BOOKING_REQUESTED=
HUBSPOT_STAGE_CONVERTED=
HUBSPOT_STAGE_NOT_PROCEEDING=

# --- Resend email notifications (Phase 1 – optional; free tier) -------
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. ASPARC <notifications@asparc.com.au>
RESEND_FROM=
# Comma-separated management recipients
NOTIFY_EMAIL_TO=
# "true" to email customers an automatic "we received your enquiry" note
SEND_CUSTOMER_ACKNOWLEDGEMENTS=false

# --- Scheduled jobs ---------------------------------------------------
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" automatically.
CRON_SECRET=

# --- Phase 2 – WhatsApp Business Platform (not yet active) ------------
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=

# --- Phase 3 – Instagram / Facebook Messenger (not yet active) --------
META_MESSENGER_ENABLED=false
META_PAGE_ACCESS_TOKEN=
# Webhook verify token for /api/webhooks/meta (any random string). Falls back to WHATSAPP_VERIFY_TOKEN.
META_VERIFY_TOKEN=
META_PAGE_ID=
INSTAGRAM_ACCOUNT_ID=

# --- Phase 4 – Bookings & payments (not yet active) -------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
CLINIKO_API_KEY=
# Cliniko shard from your API key suffix, e.g. au1
CLINIKO_SHARD=
